#!/usr/bin/env bash
# PCHH - PCIe link and error diagnostics.
. /usr/local/lib/pchh/common.sh

header "PCIe diagnostics"

if ! have lspci; then
    warn "lspci is not available."
    exit 0
fi

section "PCI devices"
lspci -D 2>/dev/null || info "No PCI devices reported."

section "Link status and error state"
link_data=$(lspci -Dvv 2>/dev/null | grep -E '^[0-9a-fA-F]{4}:|LnkSta:|DevSta:|UESta:|CESta:' || true)
if [ -n "$link_data" ]; then
    printf '%s\n' "$link_data"
else
    info "Detailed PCIe link data is not available."
fi

section "Kernel PCIe errors"
if have dmesg; then
    errors=$(dmesg 2>/dev/null | grep -iE 'pcie|aer|corrected error|uncorrected error' | grep -iE 'error|fault|fail|fatal|uncorrected' || true)
    if [ -n "$errors" ]; then
        warn "PCIe-related errors found in the current kernel log:"
        printf '%s\n' "$errors"
    else
        ok "No PCIe errors found in the current kernel log."
    fi
else
    info "dmesg is not available."
fi
